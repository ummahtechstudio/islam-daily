# Hadith data-prep working dirs (~174 MB). The trilingual data is served from
# R2 (hadiths-v2/); these raw editions + combined build output don't belong in
# the app repo. See hadith-build/README.md for provenance.
/hadith-arabic/
/hadith-urdu/
/hadith-build/

# Local-only reference material (third-party books/PDFs with unclear
# licensing). Never tracked, never shipped — app content is built from
# primary sources.
/reference/

